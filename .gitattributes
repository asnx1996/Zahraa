# Auto detect text files and perform LF normalization
* text=auto

# ملفات vendor تنحفظ بايت ببايت — لا تلمس نهايات الأسطر
# ⚠️ لازم ** مو * — النجمة الوحدة تمسك الملفات المباشرة بس،
#    وما توصل vendor/fonts/*.woff2 فتنكسر الخطوط بتحويل نهايات الأسطر
vendor/** -text

# الخطوط ثنائية صريحة — حزام وحمّالة
*.woff2 binary
*.woff  binary
